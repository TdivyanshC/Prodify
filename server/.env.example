# Local MongoDB the seed writes into. The seed DROPS every collection it owns
# in this database first, and refuses non-localhost URIs unless
# SEED_ALLOW_REMOTE=1. Transactions (Phase 2 close flow) need a replica set,
# but the seed itself does not.
MONGO_URI=mongodb://127.0.0.1:27017/prodify_dev

# --- Production ---
# NODE_ENV defaults to production. `npm run dev` and the seed scripts set
# NODE_ENV=development for you; never set it on a deployed host.
# Production refuses to boot without: MONGO_URI, JWT_SECRET (32+ chars),
# GOOGLE_WEB_CLIENT_ID, GOOGLE_ANDROID_CLIENT_ID, AUTH_MODE=google (the default),
# and CORS_ORIGINS must not contain *.
